# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
*.egg

# Virtual environments
.venv/
.worktrees/
external/upstream/
external/solvers/
.venv-ml/
venv/
env/
ENV/

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json
*credentials*
*secret*

# Testing / coverage
.pytest_cache/
.pytest_tmp/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
.cache/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Generated conversion dumps
output/

# Lista completa de términos prohibidos (086:RF-33): lleva los nombres; en git solo van sus huellas.
config/terminos_prohibidos*

# Identidad de cada instalación (086:RF-7): de esta máquina, no del código.
.convertersmartgrid-instalacion.json

# Local execution evidence and simulator acceptance reports. These may contain
# utility identifiers and machine-specific paths; publish only curated summaries.
AUDIT/

# Large CYMDIST sample TXT (keep local; do not publish utility dumps)
referencia/RED_*.txt
referencia/CARGA_*.txt
referencia/BD_Equipo*.txt


# Datos reales de la empresa distribuidora: quedan locales, no se publican.
# La plantilla de cargas y las auditorías llevan códigos de SED y de tramo reales.
referencia/*.xlsx
referencia/*.xls
referencia/*.csv
referencia/*.mdb
# DGS exportados de una red real (NA205.dgs estuvo versionado hasta el 2026-11-01 y hubo
# que reescribir el historial para sacarlo): se quedan en local como los TXT.
referencia/*.dgs
referencia/audit_ternas_*.json
# Subcarpetas de mediciones, suministros y catálogos de la distribuidora (≈1,7 GB en
# 2026-10): sin esta regla un ``git add -A`` las sube y GitHub rechaza el push (>100 MB).
referencia/*/

# Catálogo de parámetros generado: se deriva del export real y lleva los códigos de
# conductor y el kilometraje de la distribuidora. Se regenera cuando haga falta con
# tools/build_input_catalog.py, así que no se versiona.
input/*.xlsx
input/*.csv
# 080:RF-49: el catálogo de cada empresa, con su uso de la red: no se versiona.
input/empresas/

# Perfil de empresa local (spec 005): convenciones de una distribuidora, fuera del repositorio.
config/perfil_empresa.json

# Alias y nombres de columna de una distribuidora (spec 009, RF-14): como el perfil de
# empresa, viven en local. Se versionan solo los ``*.example.json``.
config/line_type_aliases.json
config/modulos_permitidos.json
config/demanda_medida_alias.json

# Instantáneas del navegador de las pruebas desde la web (Playwright).
.playwright-mcp/
# Informes y modelos de la distribuidora: no se suben (constitución P9).
referencia/*.doc
referencia/*.docx
# PDF del solicitante (spec 017): datos, no código.
referencia/*.pdf
# 102:RF-15: rutas de los datos de la distribuidora de esta máquina
config/suite_completa.json
# 103:RF-3: la PowerFactory que eligió el operador en esta máquina.
config/powerfactory.json
