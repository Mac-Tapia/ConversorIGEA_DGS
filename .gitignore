# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
*.egg

# Virtual environments
.venv/
.worktrees/
venv/
env/
ENV/

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json
*credentials*
*secret*

# Testing / coverage
.pytest_cache/
.pytest_tmp/
.coverage
htmlcov/
