{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dictamen de un rol de revisión; no autoriza ejecución",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidencia_ids", "contradicciones", "incertidumbres", "decision"],
  "properties": {
    "evidencia_ids": {"type": "array", "items": {"type": "string"}, "maxItems": 32},
    "contradicciones": {"type": "array", "items": {"type": "string"}, "maxItems": 32},
    "incertidumbres": {"type": "array", "items": {"type": "string"}, "maxItems": 32},
    "decision": {"enum": ["favorable", "bloqueada", "revisar"]}
  }
}
