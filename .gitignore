# Datos reales de la empresa distribuidora: quedan locales, no se publican.
# La plantilla de cargas y las auditorías llevan códigos de SED y de tramo reales.
referencia/*.xlsx
referencia/*.xls
referencia/*.csv
referencia/*.mdb
referencia/audit_ternas_*.json

# Catálogo de parámetros generado: se deriva del export real y lleva los códigos de
# conductor y el kilometraje de la distribuidora. Se regenera cuando haga falta con
# tools/build_input_catalog.py, así que no se versiona.
input/*.xlsx
input/*.csv
